# Copy to .env.local. Everything is optional; the app runs fully offline without it.

# Syllabus parsing and semantic study-spot search. Without a key both fall back
# to deterministic on-device logic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Minutes a matched pool from the live queue lives before it is deleted.
POOL_TTL_MINUTES=15
