# Copy to .env.local.

# --- Firestore (needed for two laptops / multiple servers to share pools) ---
# When these are set, the live store uses Firestore (study_pools, queue_entries,
# room_bookings, course_subscriptions). The Pools chip reads "Saved · Firestore".
# Easiest: download the service-account key from Firebase console
# (Project settings → Service accounts → Generate new private key) and save it
# as ./firebase-service-account.json — it is gitignored and picked up
# automatically. Or point FIREBASE_SERVICE_ACCOUNT_FILE at it, or paste the
# JSON / the three split fields below.
FIREBASE_SERVICE_ACCOUNT_FILE=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Local fallback only (used when Firebase env is missing) ---
# Snapshot directory for the single-process JSON store. Defaults to ./.data,
# then the OS temp dir. Set STUDYSPACE_PERSISTENCE=memory to skip disk.
# The UI will say Saved · local file — not a blocking "Firestore is missing" warning.
STUDYSPACE_DATA_DIR=
STUDYSPACE_PERSISTENCE=

# Syllabus parsing and semantic study-spot search. Without a key both fall back
# to deterministic on-device logic. Course relatedness never uses a model —
# it comes from lib/data/courseGraph.json (CourseTable catalog descriptions).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Minutes a matched pool from the live queue lives before it is deleted.
POOL_TTL_MINUTES=15

# Booking announcement email. Without these, announcements are written to the
# server log instead of delivered, and the API reports delivery as "logged".
RESEND_API_KEY=
MAIL_FROM=
