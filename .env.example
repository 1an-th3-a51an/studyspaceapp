# Copy to .env.local. Everything is optional; the app runs fully offline without it.

# Syllabus parsing and semantic study-spot search. Without a key both fall back
# to deterministic on-device logic. Course relatedness never uses a model —
# it comes from lib/data/courseGraph.json.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Minutes a matched pool from the live queue lives before it is deleted.
POOL_TTL_MINUTES=15

# Where the default backend writes its snapshot. Defaults to ./.data, falling
# back to the OS temp dir. Set to "memory" via STUDYSPACE_PERSISTENCE to opt out.
STUDYSPACE_DATA_DIR=
STUDYSPACE_PERSISTENCE=

# Booking announcement email. Without these, announcements are written to the
# server log instead of delivered, and the API reports delivery as "logged".
RESEND_API_KEY=
MAIL_FROM=

# Firestore (optional). The default backend already persists to disk; add these
# to share state across multiple servers instead. Collections used:
# study_pools, queue_entries, room_bookings, course_subscriptions.
# Paste the full service-account JSON *or* the three split fields.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
